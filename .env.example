# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Vite Frontend)
# Copy this file to .env.local and fill in your values
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"

# FIREBASE ADMIN SDK (Server-side - required to delete Firebase Auth users on reset)
# Option 1: Set this to the full JSON content of your Firebase service account key
# Get it from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# Option 2: Place firebase-service-account.json file in project root (add to .gitignore!)
